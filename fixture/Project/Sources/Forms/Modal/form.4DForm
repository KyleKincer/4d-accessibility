          "width": 360,
          "height": 65
        },
        "CloseModal": {
          "type": "button",
          "text": "Close modal",
          "left": 230,
          "top": 110,
          "width": 150,
          "height": 28,
          "action": "cancel",
          "events": [
            "onClick"
          ]
        }
      }
    }
  ]
}
